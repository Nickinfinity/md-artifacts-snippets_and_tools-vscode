          "when": "view == md-artifacts.variablesView && viewItem == fileFlat",
          "group": "4_apply@1"
        },
        {
          "command": "md-artifacts.variables.deleteFile",
          "when": "view == md-artifacts.variablesView && viewItem == fileFlat",
          "group": "5_delete@0"
        },
