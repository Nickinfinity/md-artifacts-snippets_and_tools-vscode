        },
        {
          "command": "md-artifacts.variables.editDescription",
          "when": "view == md-artifacts.variablesView && viewItem == fileSets",
          "group": "3_edit@1"
        },
        {
          "command": "md-artifacts.variables.editTags",
          "when": "view == md-artifacts.variablesView && viewItem == fileSets",
          "group": "3_edit@2"
        },
        {
          "command": "md-artifacts.variables.deleteFile",
          "when": "view == md-artifacts.variablesView && viewItem == fileSets",
          "group": "5_delete@0"
        },
        {
          "command": "md-artifacts.variables.addVar",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "inline@0"
        },
        {
          "command": "md-artifacts.variables.applyToPreview",
          "when": "view == md-artifacts.variablesView && viewItem == subset && md-artifacts.previewActive",
          "group": "inline@1"
        },
        {
          "command": "md-artifacts.variables.applyToEditor",
          "when": "view == md-artifacts.variablesView && viewItem == subset && editorIsOpen",
          "group": "inline@2"
        },
        {
          "command": "md-artifacts.variables.viewInfo",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "1_view@0"
        },
        {
          "command": "md-artifacts.variables.addVar",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "2_create@0"
        },
        {
          "command": "md-artifacts.variables.renameSubSet",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "3_edit@0"
        },
        {
          "command": "md-artifacts.variables.editDescription",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "3_edit@1"
        },
        {
          "command": "md-artifacts.variables.applyToPreview",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "4_apply@0"
        },
        {
          "command": "md-artifacts.variables.applyToEditor",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "4_apply@1"
        },
        {
          "command": "md-artifacts.variables.deleteSubSet",
          "when": "view == md-artifacts.variablesView && viewItem == subset",
          "group": "5_delete@0"
        },
        {
          "command": "md-artifacts.variables.editValue",
          "when": "view == md-artifacts.variablesView && viewItem == var",
          "group": "inline@0"
        },
        {
          "command": "md-artifacts.variables.viewInfo",
          "when": "view == md-artifacts.variablesView && viewItem == var",
          "group": "1_view@0"
        },
        {
          "command": "md-artifacts.variables.editValue",
          "when": "view == md-artifacts.variablesView && viewItem == var",
          "group": "3_edit@0"
        },
        {
          "command": "md-artifacts.variables.renameVar",
          "when": "view == md-artifacts.variablesView && viewItem == var",
          "group": "3_edit@1"
        },
        {
          "command": "md-artifacts.variables.deleteVar",
          "when": "view == md-artifacts.variablesView && viewItem == var",
          "group": "5_delete@0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "md-artifacts",
          "title": "%container.title%",
          "icon": "media/md-artifacts.svg"
        }
      ]
    },
    "views": {
      "md-artifacts": [
        {
          "id": "md-artifacts.mainView",
          "name": "%view.mainView.name%",
          "type": "webview"
        },
        {
          "id": "md-artifacts.variablesView",
          "name": "%view.variablesView.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "md-artifacts.mainView",
        "when": "!md-artifacts.vaultConfigured",
        "contents": "%viewsWelcome.mainView.contents%"
      },
      {
        "view": "md-artifacts.variablesView",
        "when": "!md-artifacts.vaultConfigured",
        "contents": "%viewsWelcome.variablesView.contents%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "mdArtifacts.vaultPath": {
          "type": "string",
          "default": "",
          "description": "%config.mdArtifacts.vaultPath.description%",
          "scope": "machine-overridable"
        },
        "mdArtifacts.defaultEnvironment": {
          "type": "string",
          "default": "",
          "description": "%config.mdArtifacts.defaultEnvironment.description%",
          "scope": "language-overridable"
        },
        "mdArtifacts.features.snippets": {
          "type": "boolean",
          "default": true,
          "description": "%config.mdArtifacts.features.snippets.description%"
        },
        "mdArtifacts.features.aiagentsconf": {
          "type": "boolean",
          "default": true,
          "description": "%config.mdArtifacts.features.aiagentsconf.description%"
        },
        "mdArtifacts.features.commands": {
          "type": "boolean",
          "default": false,
          "description": "%config.mdArtifacts.features.commands.description%"
        },
        "mdArtifacts.features.templates": {
          "type": "boolean",
          "default": false,
          "description": "%config.mdArtifacts.features.templates.description%"
        },
        "mdArtifacts.features.aiprompts": {
          "type": "boolean",
          "default": true,
          "description": "%config.mdArtifacts.features.aiprompts.description%"
        },
        "mdArtifacts.features.variables": {
          "type": "boolean",
          "default": false,
          "description": "%config.mdArtifacts.features.variables.description%"
        },
        "mdArtifacts.mainPane.previewWidthSteps": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "%config.mdArtifacts.mainPane.previewWidthSteps.description%"
        },
        "mdArtifacts.mainPane.variablesHeightFraction": {
          "type": "number",
          "default": 0.1667,
          "minimum": 0.05,
          "maximum": 0.5,
          "description": "%config.mdArtifacts.mainPane.variablesHeightFraction.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
