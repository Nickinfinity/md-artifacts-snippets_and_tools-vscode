{
  "name": "md-artifacts-snippets-and-tools-vscode",
  "displayName": "MD Artifacts: AI Snippets & Tools",
  "description": "Use Obsidian-compatible Markdown artifacts (snippets, templates, commands, AI prompts, variables) stored in your Obsidian vault straight from VS Code, or create new ones.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/src/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "md-artifacts.settings",
        "title": "%cmd.settings.title%"
      },
      {
        "command": "md-artifacts.insert.snippets",
        "category": "%cmd.category%",
        "title": "%cmd.insert.snippets.title%"
      },
      {
        "command": "md-artifacts.insert.aiagentsconf",
        "category": "%cmd.category%",
        "title": "%cmd.insert.aiagentsconf.title%"
      },
      {
        "command": "md-artifacts.insert.commands",
        "category": "%cmd.category%",
        "title": "%cmd.insert.commands.title%"
      },
      {
        "command": "md-artifacts.insert.templates",
        "category": "%cmd.category%",
        "title": "%cmd.insert.templates.title%"
      },
      {
        "command": "md-artifacts.insert.aiprompts",
        "category": "%cmd.category%",
        "title": "%cmd.insert.aiprompts.title%"
      },
      {
        "command": "md-artifacts.insert.aiprompts.terminal",
        "category": "%cmd.category%",
        "title": "%cmd.insert.aiprompts.terminal.title%"
      },
      {
        "command": "md-artifacts.insert.variables",
        "category": "%cmd.category%",
        "title": "%cmd.insert.variables.title%"
      },
      {
        "command": "md-artifacts.migrateFrontmatter",
        "title": "%cmd.migrateFrontmatter.title%"
      },
      {
        "command": "md-artifacts.create.snippets",
        "title": "%cmd.create.snippets.title%"
      },
      {
        "command": "md-artifacts.create.aiagentsconf",
        "title": "%cmd.create.aiagentsconf.title%"
      },
      {
        "command": "md-artifacts.create.commands",
        "title": "%cmd.create.commands.title%"
      },
      {
        "command": "md-artifacts.create.templates",
        "title": "%cmd.create.templates.title%"
      },
      {
        "command": "md-artifacts.create.aiprompts",
        "title": "%cmd.create.aiprompts.title%"
      },
      {
        "command": "md-artifacts.create.aiprompts.terminal",
        "title": "%cmd.create.aiprompts.terminal.title%"
      },
      {
        "command": "md-artifacts.create.aiagentsconf.index",
        "title": "%cmd.create.aiagentsconf.index.title%"
      },
      {
        "command": "md-artifacts.create.templates.index",
        "title": "%cmd.create.templates.index.title%"
      },
      {
        "command": "md-artifacts.variables.openFile",
        "title": "%cmd.variables.openFile.title%",
        "category": "%cmd.category%",
        "icon": "$(edit)"
      },
      {
        "command": "md-artifacts.variables.newFile",
        "title": "%cmd.variables.newFile.title%",
        "category": "%cmd.category%",
        "icon": "$(new-file)"
      },
      {
        "command": "md-artifacts.variables.newSubSet",
        "title": "%cmd.variables.newSubSet.title%",
        "category": "%cmd.category%",
        "icon": "$(add)"
      },
      {
        "command": "md-artifacts.variables.addVar",
        "title": "%cmd.variables.addVar.title%",
        "category": "%cmd.category%",
        "icon": "$(add)"
      },
      {
        "command": "md-artifacts.variables.addToBlank",
        "title": "%cmd.variables.addToBlank.title%",
        "category": "%cmd.category%",
        "icon": "$(add)"
      },
      {
        "command": "md-artifacts.variables.editDescription",
        "title": "%cmd.variables.editDescription.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "md-artifacts.variables.editTags",
        "title": "%cmd.variables.editTags.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "md-artifacts.variables.viewInfo",
        "title": "%cmd.variables.viewInfo.title%",
        "category": "%cmd.category%"
      },
      {
        "command": "md-artifacts.variables.editValue",
        "title": "%cmd.variables.editValue.title%",
        "category": "%cmd.category%",
        "icon": "$(edit)"
      },
      {
        "command": "md-artifacts.variables.renameVar",
        "title": "%cmd.variables.renameVar.title%",
        "category": "%cmd.category%",
        "icon": "$(edit)"
      },
      {
        "command": "md-artifacts.variables.deleteVar",
        "title": "%cmd.variables.deleteVar.title%",
        "category": "%cmd.category%",
        "icon": "$(trash)"
      },
      {
        "command": "md-artifacts.variables.deleteSubSet",
        "title": "%cmd.variables.deleteSubSet.title%",
        "category": "%cmd.category%",
        "icon": "$(trash)"
      },
      {
        "command": "md-artifacts.variables.deleteFile",
        "title": "%cmd.variables.deleteFile.title%",
        "category": "%cmd.category%",
        "icon": "$(trash)"
      },
      {
        "command": "md-artifacts.variables.renameSubSet",
        "title": "%cmd.variables.renameSubSet.title%",
        "category": "%cmd.category%",
        "icon": "$(edit)"
      },
      {
        "command": "md-artifacts.variables.applyToPreview",
        "title": "%cmd.variables.applyToPreview.title%",
        "category": "%cmd.category%",
        "icon": "$(play)"
      },
      {
        "command": "md-artifacts.variables.applyToEditor",
        "title": "%cmd.variables.applyToEditor.title%",
        "category": "%cmd.category%",
        "icon": "$(replace-all)"
      },
      {
        "command": "md-artifacts.variables.saveCurrentValues",
        "title": "%cmd.variables.saveCurrentValues.title%",
        "category": "%cmd.category%",
        "icon": "$(save)"
      },
      {
        "command": "md-artifacts.variables.search",
        "title": "%cmd.variables.search.title%",
        "category": "%cmd.category%",
        "icon": "$(search)"
      },
      {
        "command": "md-artifacts.variables.clearSearch",
        "title": "%cmd.variables.clearSearch.title%",
        "category": "%cmd.category%",
        "icon": "$(clear-all)"
      }
    ],
    "submenus": [
      {
        "id": "md-artifacts.submenu.editor",
        "label": "%submenu.editor.label%"
      },
      {
        "id": "md-artifacts.submenu.terminal",
        "label": "%submenu.terminal.label%"
      },
      {
        "id": "md-artifacts.submenu.explorer",
        "label": "%submenu.explorer.label%"
      },
      {
        "id": "md-artifacts.submenu.create.editor",
        "label": "%submenu.create.editor.label%"
      },
      {
        "id": "md-artifacts.submenu.create.terminal",
        "label": "%submenu.create.terminal.label%"
      },
      {
        "id": "md-artifacts.submenu.create.explorer",
        "label": "%submenu.create.explorer.label%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "md-artifacts.insert.aiprompts.terminal",
          "when": "false"
        },
        {
          "command": "md-artifacts.create.aiprompts.terminal",
          "when": "false"
        },
        {
          "command": "md-artifacts.create.aiagentsconf.index",
          "when": "false"
        },
        {
          "command": "md-artifacts.create.templates.index",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.newFile",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.openFile",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.newSubSet",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.addVar",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.addToBlank",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.editDescription",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.editTags",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.viewInfo",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.editValue",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.renameVar",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.deleteVar",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.deleteSubSet",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.deleteFile",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.renameSubSet",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.applyToPreview",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.search",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.clearSearch",
          "when": "false"
        },
        {
          "command": "md-artifacts.variables.applyToEditor",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "md-artifacts.insert.snippets",
          "when": "md-artifacts.vaultConfigured && md-artifacts.snippetsActive && !md-artifacts.editorHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.aiprompts",
          "when": "md-artifacts.vaultConfigured && md-artifacts.aipromptsActive && !md-artifacts.editorHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.vaultConfigured && md-artifacts.variablesActive && !md-artifacts.editorHasMultiple",
          "group": "mda@1"
        },
        {
          "submenu": "md-artifacts.submenu.editor",
          "when": "md-artifacts.vaultConfigured && md-artifacts.editorHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.create.snippets",
          "when": "editorHasSelection && md-artifacts.vaultConfigured && md-artifacts.snippetsActive && !md-artifacts.editorCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.aiprompts",
          "when": "editorHasSelection && md-artifacts.vaultConfigured && md-artifacts.aipromptsActive && !md-artifacts.editorCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "md-artifacts.submenu.create.editor",
          "when": "editorHasSelection && md-artifacts.vaultConfigured && md-artifacts.editorCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "terminal/context": [
        {
          "command": "md-artifacts.insert.commands",
          "when": "md-artifacts.vaultConfigured && md-artifacts.commandsActive && !md-artifacts.terminalHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.aiprompts.terminal",
          "when": "md-artifacts.vaultConfigured && md-artifacts.aipromptsActive && !md-artifacts.terminalHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.vaultConfigured && md-artifacts.variablesActive && !md-artifacts.terminalHasMultiple",
          "group": "mda@1"
        },
        {
          "submenu": "md-artifacts.submenu.terminal",
          "when": "md-artifacts.vaultConfigured && md-artifacts.terminalHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.create.commands",
          "when": "md-artifacts.vaultConfigured && md-artifacts.commandsActive && !md-artifacts.terminalCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.aiprompts.terminal",
          "when": "md-artifacts.vaultConfigured && md-artifacts.aipromptsActive && !md-artifacts.terminalCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "md-artifacts.submenu.create.terminal",
          "when": "md-artifacts.vaultConfigured && md-artifacts.terminalCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "explorer/context": [
        {
          "command": "md-artifacts.insert.templates",
          "when": "md-artifacts.vaultConfigured && md-artifacts.templatesActive && !md-artifacts.explorerHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.aiagentsconf",
          "when": "md-artifacts.vaultConfigured && md-artifacts.aiagentsconfActive && !md-artifacts.explorerHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.vaultConfigured && md-artifacts.variablesActive && !md-artifacts.explorerHasMultiple",
          "group": "mda@1"
        },
        {
          "submenu": "md-artifacts.submenu.explorer",
          "when": "md-artifacts.vaultConfigured && md-artifacts.explorerHasMultiple",
          "group": "mda@1"
        },
        {
          "command": "md-artifacts.create.aiagentsconf",
          "when": "!listMultiSelection && md-artifacts.vaultConfigured && md-artifacts.aiagentsconfActive && !md-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.aiagentsconf.index",
          "when": "listMultiSelection && md-artifacts.vaultConfigured && md-artifacts.aiagentsconfActive && !md-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.templates",
          "when": "!listMultiSelection && md-artifacts.vaultConfigured && md-artifacts.templatesActive && !md-artifacts.explorerCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "command": "md-artifacts.create.templates.index",
          "when": "listMultiSelection && md-artifacts.vaultConfigured && md-artifacts.templatesActive && !md-artifacts.explorerCreateHasMultiple",
          "group": "3_create@2"
        },
        {
          "submenu": "md-artifacts.submenu.create.explorer",
          "when": "md-artifacts.vaultConfigured && md-artifacts.explorerCreateHasMultiple",
          "group": "3_create@1"
        }
      ],
      "md-artifacts.submenu.editor": [
        {
          "command": "md-artifacts.insert.snippets",
          "when": "md-artifacts.snippetsActive",
          "group": "1_insert@1"
        },
        {
          "command": "md-artifacts.insert.aiprompts",
          "when": "md-artifacts.aipromptsActive",
          "group": "1_insert@2"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "md-artifacts.submenu.terminal": [
        {
          "command": "md-artifacts.insert.commands",
          "when": "md-artifacts.commandsActive",
          "group": "1_insert@1"
        },
        {
          "command": "md-artifacts.insert.aiprompts.terminal",
          "when": "md-artifacts.aipromptsActive",
          "group": "1_insert@2"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "md-artifacts.submenu.explorer": [
        {
          "command": "md-artifacts.insert.templates",
          "when": "md-artifacts.templatesActive",
          "group": "1_insert@1"
        },
        {
          "command": "md-artifacts.insert.aiagentsconf",
          "when": "md-artifacts.aiagentsconfActive",
          "group": "1_insert@2"
        },
        {
          "command": "md-artifacts.insert.variables",
          "when": "md-artifacts.variablesActive",
          "group": "2_variables@1"
        }
      ],
      "md-artifacts.submenu.create.editor": [
        {
          "command": "md-artifacts.create.snippets",
          "when": "md-artifacts.snippetsActive",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.aiprompts",
          "when": "md-artifacts.aipromptsActive",
          "group": "3_create@2"
        }
      ],
      "md-artifacts.submenu.create.terminal": [
        {
          "command": "md-artifacts.create.commands",
          "when": "md-artifacts.commandsActive",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.aiprompts.terminal",
          "when": "md-artifacts.aipromptsActive",
          "group": "3_create@2"
        }
      ],
      "md-artifacts.submenu.create.explorer": [
        {
          "command": "md-artifacts.create.aiagentsconf",
          "when": "!listMultiSelection && md-artifacts.aiagentsconfActive",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.templates",
          "when": "!listMultiSelection && md-artifacts.templatesActive",
          "group": "3_create@2"
        },
        {
          "command": "md-artifacts.create.aiagentsconf.index",
          "when": "listMultiSelection && md-artifacts.aiagentsconfActive",
          "group": "3_create@1"
        },
        {
          "command": "md-artifacts.create.templates.index",
          "when": "listMultiSelection && md-artifacts.templatesActive",
          "group": "3_create@2"
        }
      ],
      "view/title": [
        {
          "command": "md-artifacts.variables.search",
          "when": "view == md-artifacts.variablesView",
          "group": "navigation@0"
        },
        {
          "command": "md-artifacts.variables.clearSearch",
          "when": "view == md-artifacts.variablesView && md-artifacts.variablesFiltered",
          "group": "navigation@0"
        },
        {
          "command": "md-artifacts.variables.newFile",
          "when": "view == md-artifacts.variablesView",
          "group": "navigation@1"
        },
        {
          "command": "md-artifacts.variables.saveCurrentValues",
          "when": "view == md-artifacts.variablesView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "md-artifacts.variables.addToBlank",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "inline@0"
        },
        {
          "command": "md-artifacts.variables.openFile",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "inline@1"
        },
        {
          "command": "md-artifacts.variables.deleteFile",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "inline@2"
        },
        {
          "command": "md-artifacts.variables.viewInfo",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "1_view@0"
        },
        {
          "command": "md-artifacts.variables.addVar",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "2_create@0"
        },
        {
          "command": "md-artifacts.variables.newSubSet",
