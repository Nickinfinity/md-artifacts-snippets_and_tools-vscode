    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
