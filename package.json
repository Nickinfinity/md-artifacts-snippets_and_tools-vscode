          "group": "2_create@1"
        },
        {
          "command": "md-artifacts.variables.openFile",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "3_edit@0"
        },
        {
          "command": "md-artifacts.variables.editDescription",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
          "group": "3_edit@1"
        },
        {
          "command": "md-artifacts.variables.editTags",
          "when": "view == md-artifacts.variablesView && viewItem == fileBlank",
