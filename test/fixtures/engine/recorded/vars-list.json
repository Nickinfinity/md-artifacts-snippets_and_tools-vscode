      "path": "Variables/vars-with-descriptions-multiline.md",
      "name": "vars-with-descriptions-multiline",
      "title": "JavaScript Array Domains",
      "description": "Real-world collections for the JavaScript Array Utilities snippet — each sub-set names the array, the field to work on, a sample value and the result variable",
      "tags": [
        "javascript",
        "array",
        "utils",
        "collections"
      ],
      "shape": "sets",
      "subsets": [
        {
          "index": 0,
          "heading": "Users",
          "description": "Active users keyed by `status`; works for\nfilter, find, map, group and dedupe.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "users"
            },
            {
              "name": "VK-result",
              "defaultValue": "activeUsers"
            },
            {
              "name": "VK-property",
              "defaultValue": "status"
            },
            {
              "name": "VK-value",
              "defaultValue": "\"active\""
            }
          ]
        },
        {
          "index": 1,
          "heading": "Products",
          "description": "A product catalogue grouped or filtered by `category`.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "products"
            },
            {
              "name": "VK-result",
              "defaultValue": "stationery"
            },
            {
              "name": "VK-property",
              "defaultValue": "category"
            },
            {
              "name": "VK-value",
              "defaultValue": "\"stationery\""
            }
          ]
        },
        {
          "index": 2,
          "heading": "Orders",
          "description": "Orders summed or sorted by their numeric `total`.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "orders"
            },
            {
              "name": "VK-result",
              "defaultValue": "revenue"
            },
            {
              "name": "VK-property",
              "defaultValue": "total"
            },
            {
              "name": "VK-value",
              "defaultValue": "100"
            }
          ]
        },
        {
          "index": 3,
          "heading": "Tasks",
          "description": "A to-do list filtered by `priority`.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "tasks"
            },
            {
              "name": "VK-result",
              "defaultValue": "urgentTasks"
            },
            {
              "name": "VK-property",
              "defaultValue": "priority"
            },
            {
              "name": "VK-value",
              "defaultValue": "\"high\""
            }
          ]
        },
        {
          "index": 4,
          "heading": "API page",
          "description": "Chunk an API response into pages of 25.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "response.data"
            },
            {
              "name": "VK-result",
              "defaultValue": "pages"
            },
            {
              "name": "VK-size",
              "defaultValue": "25"
            }
          ]
        },
        {
          "index": 5,
          "heading": "Tags",
          "description": "A flat array of strings — for Deduplicate primitives and Flatten one level.",
          "vars": [
            {
              "name": "VK-array",
              "defaultValue": "tags"
            },
            {
              "name": "VK-result",
              "defaultValue": "uniqueTags"
            }
          ]
        }
      ]
    },
