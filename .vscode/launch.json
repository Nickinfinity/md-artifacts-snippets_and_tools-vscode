// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension (built-in launcher)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions" //disable all other extensions
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			// Workaround for "Extension host did not start in 10 seconds": the
			// built-in launcher attaches via `localhost`, which macOS resolves to
			// ::1 first, while the extension host inspector listens on 127.0.0.1
			// only. Here the dev host is started by a task and we attach to the
			// IPv4 address explicitly.
			"name": "Run Extension",
			"type": "node",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9339,
			"timeout": 30000,
			"continueOnAttach": true,
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "Launch Dev Host (inspect 9339)"
		}
	]
}
