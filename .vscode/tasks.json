// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Watch TypeScript",
			"type": "shell",
			"command": "pnpm run watch",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			// Opens the dev host paused on 127.0.0.1:9339 for the
			// "Run Extension" launch config.
			"label": "Launch Dev Host (inspect 9339)",
			"type": "process",
			"command": "code",
			"args": [
				"--new-window",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--disable-extensions",
				"--inspect-brk-extensions=9339"
			],
			"dependsOn": "Watch TypeScript",
			"presentation": {
				"reveal": "never"
			},
			"problemMatcher": []
		}
	]
}
